# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:4200

# Database Configuration (Sequelize Connection Pool)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blue_royal_hrms_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRATION_DAYS=7

# Initial Admin Bootstrap
INITIAL_ADMIN_EMAIL=admin@blueroyal.com
INITIAL_ADMIN_PASSWORD=Admin@123456

# Logging
LOG_LEVEL=info
