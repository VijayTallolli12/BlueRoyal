{
  "name": "blue-royal-hrms",
  "version": "1.0.0",
  "private": true,
  "description": "Blue Royal HRMS - Enterprise Human Resource Management System",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "database"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=packages/contracts && npm run build --workspace=database && npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:contracts": "npm run build --workspace=packages/contracts",
    "build:database": "npm run build --workspace=database",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md,html,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,html,scss}\"",
    "db:migrate": "npm run migrate --workspace=database",
    "db:migrate:undo": "npm run migrate:undo --workspace=database",
    "db:seed": "npm run seed --workspace=database",
    "db:seed:demo": "npm run seed:demo --workspace=database",
    "db:status": "npm run status --workspace=database"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "6.0.11"
  }
}
