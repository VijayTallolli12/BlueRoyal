# ==============================================================================
# BLUE ROYAL HRMS — RENDER PRODUCTION & STAGING ENVIRONMENT TEMPLATE
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=10000
API_PREFIX=/api/v1

# CORS — Allowed Frontend Origin (NO wildcard in production/staging)
# e.g. https://blue-royal-hrms.onrender.com or your custom domain https://hrms.yourdomain.com
CORS_ORIGIN=https://blue-royal-hrms.onrender.com

# PostgreSQL Connection — Render Managed Database
# Render automatically injects DATABASE_URL or DATABASE_INTERNAL_URL.
# If connecting manually:
DATABASE_URL=postgresql://blue_royal_admin:your_secure_password@dpg-xxxxxx-a.oregon-postgres.render.com/blue_royal_hrms
DB_SSL=true

# Alternative discrete connection settings (if not using DATABASE_URL):
DB_HOST=dpg-xxxxxx-a.oregon-postgres.render.com
DB_PORT=5432
DB_NAME=blue_royal_hrms
DB_USER=blue_royal_admin
DB_PASSWORD=your_secure_password
DB_LOGGING=false
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000

# Document Storage Path (maps to Render Persistent Disk mount)
# Mount disk at: /opt/render/project/src/backend/storage
STORAGE_PATH=storage/documents

# Authentication & Security
# Generate strong 256-bit secrets via: openssl rand -hex 32
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long
JWT_REFRESH_EXPIRATION_DAYS=7

# Cookie Security Settings for Cross-Subdomain Render Hosting:
# When frontend is on https://xxx.onrender.com and backend is on https://yyy.onrender.com:
# Set COOKIE_SAME_SITE=none and COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# Initial Super Administrator Seed (Used on first database seed)
INITIAL_ADMIN_EMAIL=admin@blueroyal.com
INITIAL_ADMIN_PASSWORD=ChangeThisSecurePassword!2026

# Logging Level
LOG_LEVEL=info
