{
  "name": "@blue-royal/database",
  "version": "1.0.0",
  "description": "Database migration and seeding lifecycle tooling for Blue Royal HRMS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "migrate": "ts-node src/scripts/migrate.ts up",
    "migrate:undo": "ts-node src/scripts/migrate.ts down",
    "status": "ts-node src/scripts/migrate.ts status",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:demo": "ts-node src/scripts/seed-demo-users.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.9",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3",
    "sequelize": "^6.37.5",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
